,"width":26,"text":"手","x":384},{"y":1684,"height":24,"width":25,"text":"か","x":412},{"y":1682,"height":26,"width":26,"text":"げ","x":440},{"y":1684,"height":23,"width":25,"text":"ん","x":467},{"y":1682,"height":26,"width":24,"text":"す","x":494},{"y":1684,"height":23,"width":20,"text":"る","x":523},{"y":1686,"height":19,"width":18,"text":"こ","x":552},{"y":1683,"height":24,"width":18,"text":"と","x":580},{"y":1683,"height":25,"width":23,"text":"な","x":604},{"y":1683,"height":25,"width":14,"text":"く","x":635},{"y":1700,"height":9,"width":8,"text":"。","x":658}]},{"text":"( 「 朝 日 新 聞 」 く 天 声 人 語 > 2010 年 7 月 27 日 付 )","words":[{"y":1606,"height":24,"width":8,"text":"(","x":799},{"y":1606,"height":20,"width":9,"text":"「","x":811},{"y":1606,"height":24,"width":23,"text":"朝","x":822},{"y":1607,"height":23,"width":17,"text":"日","x":850},{"y":1606,"height":24,"width":24,"text":"新","x":872},{"y":1607,"height":23,"width":22,"text":"聞","x":898},{"y":1610,"height":20,"width":9,"text":"」","x":922},{"y":1605,"height":25,"width":11,"text":"く","x":948},{"y":1606,"height":24,"width":24,"text":"天","x":960},{"y":1605,"height":24,"width":23,"text":"声","x":986},{"y":1606,"height":23,"width":24,"text":"人","x":1011},{"y":1605,"height":24,"width":24,"text":"語","x":1036},{"y":1605,"height":24,"width":11,"text":">","x":1062},{"y":1607,"height":20,"width":59,"text":"2010","x":1088},{"y":1604,"height":25,"width":23,"text":"年","x":1156},{"y":1607,"height":20,"width":12,"text":"7","x":1188},{"y":1606,"height":23,"width":20,"text":"月","x":1209},{"y":1608,"height":20,"width":28,"text":"27","x":1241},{"y":1607,"height":22,"width":17,"text":"日","x":1281},{"y":1605,"height":25,"width":24,"text":"付","x":1303},{"y":1605,"height":25,"width":9,"text":")","x":1328}]}],"pdfPage":91,"height":2149,"text":"問 題 9 次 の 文 章 を 読 ん で 、 匚 亘 0 こ ] か ら 匚 コ の 中 に 入 る 最 も よ い も の を 、 1 ・ 2 ・ 3 ・ 4 か ら 一 つ 選 び な さ い 。 も り つ よ し き よ う た い ( 注 3 ) ぼ ち ぼ ち ・ ・ ・ 少 し ず っ ゆ っ く り 。 し 、 つ わ じ ゅ う じ つ 森 さ ん が 亡 く な っ た 。 退 官 後 は 自 ら 「 老 人 」 や 「 言 論 芸 能 人 」 と 称 し て い た 。 し よ う げ ん ろ ん さ ま ざ ま な 逸 話 や 、 社 会 問 題 へ の 「 な 発 言 で 「 最 後 の 名 物 教 授 」 と 親 し ま れ た め い ふ つ を 送 れ 」 と 言 わ れ て い た そ う た 。 学 生 の こ ろ よ く サ ホ っ た 。 父 親 に は 「 学 校 を 休 ん た 日 は 、 学 校 へ 行 く よ り 充 実 し た 一 日 せ に 出 来 の 悪 い の は 容 赦 な く ( 注 1 ) [ 5 ] ぞ 」 。 学 生 は 黙 っ て し ま っ た そ う で あ る 。 自 身 、 よ う し や 「 よ っ し や 、 出 席 し て な い ャ ツ は 少 々 答 案 の 出 来 が 悪 く て も [ コ け ど 、 出 席 し た く と ら し い 。 匚 : 5 可 」 こ う 答 え た そ う た 。 出 席 を と っ て ほ し い と 学 生 が 言 っ て き た 。 単 位 取 得 に 出 席 を 考 慮 し て ほ し い 、 と い う こ こ う り よ 数 学 者 の 森 毅 さ ん は 京 大 の 教 授 だ っ た こ ろ 、 授 業 で 出 席 を と ら な か っ た 。 あ る と き 、 と っ ぴ ょ う し ひ ょ う ひ ょ う か げ き 『 エ 工 カ ゲ ン が 面 白 い 』 『 ま あ 、 え え や な い か 』 『 ぼ ち ぼ ち ( 注 3 ) い こ か 』 お も し ろ カ タ ン ( 注 2 ) で す わ 」 。 は み 出 し が ち な 人 へ の 愛 情 が 言 葉 の 端 々 に に じ ん だ 。 は し ば し こ と を 始 め る に は 優 等 生 だ け で は だ め 。 突 拍 子 も な い こ と を 言 い 出 す の は 、 大 抵 は ス 発 言 は し な や か で 飄 々 、 と き に 過 激 で も あ っ た 。 だ が 姿 勢 は 一 貫 し て い た 。 「 新 し い し せ い い っ か ん 自 分 に も 他 人 に も 、 印 と 放 任 を 貫 い た 人 だ っ た 。 つ ら ぬ 。 肩 の カ た い て い く け ん 生 な ん て そ う あ る も ん や な い よ 」 。 享 年 82 。 あ の 柔 ら か い 関 西 弁 が ど こ か ら か 聞 こ え る か ん さ い ペ ん き よ う ね ん 入 学 か ら 就 職 ま で 最 短 で 駆 け 抜 け る 今 の 大 学 に 、 さ ぞ 苦 言 は 4 コ 「 予 定 通 り の 人 し ゃ う し よ く ん ば れ と い う メ ッ セ ー ジ が 多 す ぎ る 」 と 「 塾 酊 」 を 抜 い た 著 書 名 の 数 々 は 、 人 生 の 達 人 か ら の エ ー ル で も あ っ た ろ う 。 「 元 気 に な れ 、 が 92 ( 注 1 ) 容 赦 な く 気 が す る 。 ( 注 2 ) ス カ タ ン ・ ・ ・ あ て の は ず れ る こ と 、 ま た 見 当 違 い の こ と を や る 人 。 ・ 手 か げ ん す る こ と な く 。 ( 「 朝 日 新 聞 」 く 天 声 人 語 > 2010 年 7 月 27 日 付 )"}