s":[{"y":1659,"height":13,"width":7,"text":"く","x":393},{"y":1660,"height":12,"width":10,"text":"さ","x":406},{"y":1659,"height":13,"width":11,"text":"き","x":426},{"y":1659,"height":12,"width":13,"text":"せ","x":473},{"y":1661,"height":10,"width":12,"text":"い","x":487},{"y":1659,"height":12,"width":10,"text":"き","x":509}]},{"text":"( 「 朝 日 新 聞 」 く 天 声 人 語 〉 2010 年 7 月 18 日 付 )","words":[{"y":1597,"height":24,"width":8,"text":"(","x":806},{"y":1596,"height":20,"width":9,"text":"「","x":818},{"y":1596,"height":25,"width":23,"text":"朝","x":828},{"y":1598,"height":22,"width":17,"text":"日","x":857},{"y":1596,"height":24,"width":23,"text":"新","x":879},{"y":1597,"height":23,"width":22,"text":"聞","x":905},{"y":1600,"height":20,"width":9,"text":"」","x":929},{"y":1596,"height":24,"width":12,"text":"く","x":954},{"y":1597,"height":23,"width":23,"text":"天","x":967},{"y":1595,"height":24,"width":24,"text":"声","x":992},{"y":1596,"height":23,"width":24,"text":"人","x":1017},{"y":1595,"height":24,"width":24,"text":"語","x":1043},{"y":1595,"height":24,"width":11,"text":"〉","x":1068},{"y":1598,"height":19,"width":60,"text":"2010","x":1094},{"y":1594,"height":25,"width":24,"text":"年","x":1162},{"y":1598,"height":20,"width":12,"text":"7","x":1195},{"y":1597,"height":22,"width":20,"text":"月","x":1216},{"y":1598,"height":20,"width":26,"text":"18","x":1251},{"y":1597,"height":22,"width":18,"text":"日","x":1288},{"y":1595,"height":25,"width":24,"text":"付","x":1310},{"y":1595,"height":25,"width":9,"text":")","x":1335}]}],"pdfPage":83,"height":2149,"text":"問 題 9 次 の 文 章 を 読 ん で 、 ・ 2 ・ 3 ・ 4 か ら 一 つ 選 び な さ い 。 50 か ら 54 の 中 に 入 る 最 も よ い も の を 、 1 ト マ ト は 野 菜 か 果 物 か 、 と い う 古 い 論 争 が あ る 。 往 時 の 米 国 で の こ と 、 輸 入 野 菜 に は う っ た ひ か せ い か ん ぜ い 10 % の 関 税 が か か る の に 、 果 物 は 非 課 税 た っ た 。 業 者 が ト マ ト も 果 物 だ と 訴 え る と 、 「 デ し り ぞ ザ ー ト に な ら な い 」 と の 理 由 で 退 け ら れ た と い う 。 近 刊 『 極 楽 ト マ ト 』 ( 講 談 社 ) で 知 っ た 。 ぜ ん ざ い サ ラ タ に し た り 、 小 工 ビ を 詰 め た り 、 匚 5 : : コ 、 赤 い 実 の 役 ど こ ろ は 前 菜 か 付 け 合 わ せ の よ う だ 。 蒸 し 暑 い タ に は 、 う ん と 冷 や し た の に 塩 を ふ る だ け で い い 。 皿 の 上 の 晴 れ は ち 姿 を 「 5 暄 」 、 ト マ ト 2 鉢 を ベ ラ ン ダ で 「 い : 〕 ち ゅ う だ ま 赤 い ミ ニ と オ レ ン ジ 色 の 中 玉 で あ る 。 黄 色 の 5 コ が し お れ る ( 注 1 ) と 、 小 さ な 青 い [ : 5 が 残 る 。 そ れ が 膨 ら み 、 [ : 委 朝 の 盛 り に 次 々 と 色 づ い た 。 休 日 の 朝 、 起 き が け つ に い く つ か 摘 ん だ 。 こ れ 以 上 の も ぎ た て は な い 。 さ ん み 店 頭 の 品 よ り 皮 が 厚 い が 、 ほ の か な 甘 み と 酸 味 が う れ し い 。 ひ い き 目 ( 注 2 ) で 合 格 点 と し 、 苗 を 下 さ っ た 人 に 写 真 を 添 え て お 知 ら せ し た 。 〈 眠 り 足 り 朝 の ト マ ト の 甘 き こ と > う ら べ お き 浦 部 熾 。 鉢 や 土 へ の 出 費 を 思 え ば 高 価 な 粒 と 匚 : : ] 、 さ さ や か な 自 給 自 足 に 学 ん だ こ と は 多 い 。 照 れ ば 葉 が 、 降 れ ば 根 が 、 吹 け は 実 が 気 に な る 明 け 暮 れ 。 く オ ロ オ ロ ア ル キ > の 宮 ざ わ け ん じ 沢 賢 治 で あ る 。 農 家 に は 笑 わ れ よ う が 、 「 食 べ る 」 の 前 に た く さ ん の 「 案 じ る 」 が あ る と 知 っ た 。 か な り の 地 方 で 一 気 に 桷 雨 が 明 け た 。 農 業 で は 盛 夏 に 備 え て 水 を た め 込 む 時 期 な が ら 、 頃 合 い と い う も の を 知 ら な い 雨 の こ と 、 匚 」 ほ ど な く 「 食 べ る だ け 」 に 戻 る 身 で て ん べ ん ち い は あ る が 、 天 変 地 異 の な い 、 し つ か り し た 夏 を 願 う 。 す が た さ か な え は ち み や せ い か 。 つ ゆ ( 注 2 ) ひ い き 目 ・ ・ 気 に 入 っ た も の を 引 き 立 て て 好 意 的 に 見 る こ と 。 ( 注 1 ) し お れ る ・ ・ 草 木 が 生 気 を 失 っ て ぐ っ た り す る 。 く さ き せ い き ( 「 朝 日 新 聞 」 く 天 声 人 語 〉 2010 年 7 月 18 日 付 )"}