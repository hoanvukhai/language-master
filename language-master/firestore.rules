rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Collection: users ───────────────────────────────────────────────────
    match /users/{userId} {

      // CHO PHÉP BẤT KỲ AI (kể cả chưa đăng nhập) đọc tài liệu user
      // để bảng xếp hạng hoạt động đúng cho tất cả người dùng.
      // Các trường nhạy cảm (email, v.v.) không được lưu ở đây.
      allow read: if true;

      // Chỉ chính chủ mới được ghi vào tài liệu của mình
      allow write: if request.auth != null && request.auth.uid == userId;

      // ── Sub-collection: srs_progress (tiến độ học) ──────────────────────
      match /srs_progress/{docId} {
        // Chỉ chính chủ đọc/ghi tiến độ SRS của mình
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // ── Sub-collection: gameScores (điểm đua từng game) ─────────────────
      match /gameScores/{scoreId} {
        // Đọc: ai cũng xem được (để hiển thị bảng xếp hạng chi tiết)
        allow read: if true;
        // Ghi: chỉ chính chủ
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // ── Sub-collection: jlpt_attempts (lịch sử luyện đề JLPT gọn nhẹ) ──────
      // Lưu số liệu tổng, ID câu/đáp án gọn nhẹ; chỉ lưu bài Thi thử (giữ 20 bài gần nhất).
      match /jlpt_attempts/{attemptId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.v == 1
          && request.resource.data.mode == 'mock'
          && request.resource.data.kind == 'pool'
          && request.resource.data.correct is int
          && request.resource.data.correct >= 0
          && request.resource.data.total is int
          && request.resource.data.total > 0
          && request.resource.data.total <= 1080
          && request.resource.data.wrongIds is list
          && request.resource.data.wrongIds.size() <= 1080
          && (!('questionIds' in request.resource.data)
            || (request.resource.data.questionIds is list
              && request.resource.data.questionIds.size() <= 1080))
          && (!('flagIds' in request.resource.data)
            || (request.resource.data.flagIds is list
              && request.resource.data.flagIds.size() <= 1080));
      }

      // ── Sub-collection: jlpt_stats (bộ đếm số lần thi thử, không giảm khi xóa lịch sử) ──
      match /jlpt_stats/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId
          && docId == 'summary'
          && request.resource.data.mockCount is int
          && request.resource.data.mockCount >= 0
          && request.resource.data.mockCount <= 1000000;
      }

      // ── Sub-collection: jlpt_drafts (bài JLPT đang làm dở, mỗi bài một tài liệu) ──
      // Chỉ chủ tài khoản đọc/ghi (trước đây nằm trong users/{uid}.jlptDrafts nên ai cũng đọc được).
      match /jlpt_drafts/{draftId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.id == draftId
          && request.resource.data.questionIds is list
          && request.resource.data.questionIds.size() > 0
          && request.resource.data.questionIds.size() <= 1080
          && request.resource.data.mode in ['drill', 'mock'];
      }
    }

    // ── Collection: custom_courses (Bộ từ vựng người dùng tự tạo) ───────────
    match /custom_courses/{courseId} {
      // Đọc: Cho phép đọc để hiển thị Khám phá cộng đồng và danh sách của tôi
      allow read: if true;
      // Tạo: người đã đăng nhập, và phải ghi đúng mình là tác giả
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      // Sửa: chỉ tác giả hiện tại của khóa học, và không được đổi tác giả
      allow update: if request.auth != null
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId;
      // Xóa: chỉ tác giả hiện tại
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }

    // Các collection khác: mặc định từ chối
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
