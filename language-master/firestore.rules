rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Collection: users ───────────────────────────────────────────────────
    match /users/{userId} {

      // CHO PHÉP BẤT KỲ AI (kể cả chưa đăng nhập) đọc tài liệu user
      // để bảng xếp hạng hoạt động đúng cho tất cả người dùng.
      // Các trường nhạy cảm (email, v.v.) không được lưu ở đây.
      allow read: if true;

      // Chỉ chính chủ mới được ghi vào tài liệu của mình
      allow write: if request.auth != null && request.auth.uid == userId;

      // ── Sub-collection: srs_progress (tiến độ học) ──────────────────────
      match /srs_progress/{docId} {
        // Chỉ chính chủ đọc/ghi tiến độ SRS của mình
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // ── Sub-collection: gameScores (điểm đua từng game) ─────────────────
      match /gameScores/{scoreId} {
        // Đọc: ai cũng xem được (để hiển thị bảng xếp hạng chi tiết)
        allow read: if true;
        // Ghi: chỉ chính chủ
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── Collection: custom_courses (Bộ từ vựng người dùng tự tạo) ───────────
    match /custom_courses/{courseId} {
      // Đọc: Cho phép đọc để hiển thị Khám phá cộng đồng và danh sách của tôi
      allow read: if true;
      // Tạo: Chỉ người dùng đã đăng nhập
      allow create: if request.auth != null;
      // Cập nhật, Xóa: Tác giả tạo ra khóa học hoặc chính chủ
      allow update, delete: if request.auth != null && (resource.data.authorId == request.auth.uid || request.resource.data.authorId == request.auth.uid);
    }

    // Các collection khác: mặc định từ chối
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
